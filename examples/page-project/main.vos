@vos 1.0;
@domain kernel;

unit os::vir::kernel
{
    identity {
        name = "VIR PAGE Workstation";
        version = 1.3.0;
        architecture = vos74;
        abi = vosabi::1;
    }

    compile {
        safety = strict;
        bounds = checked;
        overflow = trap;
        nullability = forbidden;
        optimization = aggressive;
    }
}

import vos::core;
import vos::memory;
import vos::interrupts;
import vos::hardware;
import vos::display;
import vos::graphics;
import vos::input;
import vos::filesystem;
import vos::terminal;
import vos::compositor;
import vos::desktop;

// VOS ABI 2 application manifests. The desktop discovers these automatically.
app WelcomeApp {
    id = "welcome";
    title = "Welcome";
    renderer = "welcome";
    icon = "V";
    width = 620;
    height = 390;
    category = "system";
    capabilities = "ui.draw,ui.input,events.emit";
    renderer = "page";
    pages = "pages/welcome.page";
    entryPage = "pages/welcome.page";
    pageStrict = true;
}

